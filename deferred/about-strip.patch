@@ -156,6 +156,24 @@ body.collapsed .ghost-btn, body.collapsed .accent-btn { justify-content: center;
 .stat-value { font-size: 24px; font-weight: 700; color: var(--accent); }
 .stat-label { font-size: 13px; color: var(--muted); margin-top: 3px; }
 
+/* ---- Auto-scrolling image band (front page, above the hero) -------------
+   Full-width marquee built from every project image. The set is doubled in
+   the markup, so sliding the track by exactly half its width (-50%) loops
+   seamlessly. Hover to pause; motion is disabled for reduced-motion users. */
+.strip { overflow: hidden; background: var(--panel); border-bottom: 1px solid var(--border); padding: 16px 0; }
+.strip-track { display: flex; width: max-content; animation: strip-scroll 60s linear infinite; }
+.strip:hover .strip-track { animation-play-state: paused; }
+.strip-item {
+  flex: none; width: 240px; height: 150px; margin-right: 14px;
+  border: 1px solid var(--border); border-radius: 12px; overflow: hidden; background: var(--chip);
+}
+.strip-item img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .3s ease; }
+.strip-item:hover img { transform: scale(1.04); }
+@keyframes strip-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
+@media (prefers-reduced-motion: reduce) {
+  .strip-track { animation: none; overflow-x: auto; width: 100%; }
+}
+
 /* ---- PROJECT cards  (resize these without affecting the gallery) -------- */
 .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
 

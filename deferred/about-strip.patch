+      (cfg.projects || []).forEach(function (p) {
+        (p.images || []).forEach(function (img) {
+          items.push(
+            '<a class="strip-item" href="' + projHref(p) + '" title="' + esc(p.title) + '" aria-label="' + esc(p.title) + '">' +
+              '<img src="' + esc(img.src) + '" alt="' + esc(img.caption || p.title) + '" loading="lazy">' +
+            '</a>'
+          );
+        });
+      });
